# M5Stack StickS3: ESP32-S3-PICO-1-N8R8 -- 8MB quad flash, 8MB octal PSRAM.
# Run flash and PSRAM at 80MHz (AMYboard's 120MHz is not validated here).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_ESPTOOLPY_OCT_FLASH=n
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/STICKS3/partitions-8MB.csv"
