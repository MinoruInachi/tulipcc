# Tab5 ESP32-P4 board configuration.

# Build for speed, not for debugging. The default (-Og) costs roughly a third of
# the frame time in the display compositor and in AMY. Assertions stay on but
# drop their file/line strings, so a failed assert still aborts with a backtrace.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE is not set

# MicroPython owns core 1: mp_task runs unbounded Python at ESP_TASK_PRIO_MIN + 1,
# so core 1's idle task legitimately never runs while a script (or a long print)
# is executing, and the idle-task watchdog fires every 5 seconds. Upstream
# MicroPython turns this check off for exactly that reason, in
# micropython/ports/esp32/boards/sdkconfig.base -- which Tulip's ESP32-S3 boards
# inherit through their SDKCONFIG_DEFAULTS list, and which TAB5 does not, because
# its mpconfigboard.cmake sets SDKCONFIG_DEFAULTS to this file alone. That is the
# whole reason "IDLE1 did not reset the watchdog" happens here and not on Tulip CC.
#
# Core 0's check stays on deliberately: nothing there is allowed to run forever
# (the audio task blocks in the codec write, the display task on VSYNC, touch on
# its notify), so IDLE0 starving is a real fault worth reporting.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Two DSI frame buffers: the display bridge composes into the off-screen one and
# hands it over by pointer, so esp_lcd_panel_draw_bitmap() stops memcpy'ing
# 1.8 MB per frame and the panel stops tearing. Costs one extra 1.8 MB of PSRAM.
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
# What tulip.cpu() reads. Both default to n in ESP-IDF, and TAB5 gets the IDF
# defaults because its mpconfigboard.cmake points SDKCONFIG_DEFAULTS at this file
# alone -- Tulip's ESP32-S3 boards turn the same thing on in boards/sdkconfig.tulip.
# GENERATE_RUN_TIME_STATS is what fills in TaskStatus_t.ulRunTimeCounter, and it
# selects USE_TRACE_FACILITY, without which uxTaskGetSystemState() does not exist
# at all. The cost is an esp_timer read per context switch plus a few bytes per TCB.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESP32P4_REV_MIN_FULL=1
CONFIG_BSP_ERROR_CHECK=y
# The same LV_CONF_SKIP divergence as the theme settings below: lv_conf.h builds
# montserrat 8/12/18/24/36 and unscii 8/16, but Kconfig only defaults to 12/14.
# Apps that ask for one of the others -- Wordpad wants font_montserrat_24 -- died
# with AttributeError on TAB5 while working everywhere else. Build the same set.
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LV_FONT_UNSCII_16=y
# Match the LVGL look of every other Tulip target. TAB5 is built with
# LV_CONF_SKIP, so it takes its LVGL settings from Kconfig instead of
# lv_binding_micropython_tulip/lv_conf.h -- and the Kconfig defaults are not
# the same file's values. lv_conf.h sets LV_THEME_DEFAULT_DARK 1,
# LV_THEME_DEFAULT_GROW 0 and montserrat_12 as the default font; Kconfig
# defaults to the light theme, grow-on-press, and montserrat_14. That is why
# apps built on ui.py (Drums, Voices, Juno-6) came up with white widgets here
# and dark ones on Tulip CC and the desktop build.
CONFIG_LV_THEME_DEFAULT_DARK=y
# CONFIG_LV_THEME_DEFAULT_GROW is not set
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_12=y
# CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14 is not set
# LVGL memory belongs to the MicroPython GC, as it does on every other Tulip
# target through LV_USE_STDLIB_MALLOC = LV_STDLIB_MICROPYTHON. Kconfig has no
# MicroPython option, so TAB5 selects custom and reimplements it in
# lv_mem_tab5.c, and hands LVGL's global state to the GC via lv_global_tab5.h.
# Both halves are required: the allocator alone would let the collector free
# live widgets, and the global alone would leave the widget wrappers
# unreachable. That second failure is why touching a Drums switch panicked in
# get_native_obj() -- LVGL called back through a collected mp_lv_obj_t.
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_ENABLE_GLOBAL_CUSTOM=y
CONFIG_LV_GLOBAL_CUSTOM_INCLUDE="lv_global_tab5.h"

# External USB hubs on the USB-A connector. Off by default in the host library.
# The connector's 5V is a single load switch off the board's own rail, so a
# bus-powered device that wants more than it can give (a KORG microKEY-37 does
# not even light its power LED) has to come in through a self-powered hub --
# which only works if the host library knows how to enumerate one.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# Enumeration timing is deliberately left at the ESP-IDF defaults.
#
# A KORG microKEY-37 loses its first EP0 control transfer ("USBH: Dev 0 EP 0
# Error") on most connects here, and the obvious guess -- that it is a settling
# problem and wants more time -- was measured and is wrong. Debounce 250->500,
# reset hold 30->50, reset recovery 30->100 and SetAddress recovery 10->50 were
# all tried together: the retry count per boot did not move (still 1-3 of them),
# so the extra delay bought nothing and was taken back out. What makes the port
# reliable is the VBUS-cycle retry in usb_host_tab5.c, not the timing.

# ESP32-C6 ESP-Hosted SDIO wiring on Tab5.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15

# Wi-Fi association latency. Measured on Tab5, tulip.wifi() spent ~6s: ~2.6s of
# scan+auth on the C6 and ~2.4s in DHCP. Almost all of the DHCP half is lwIP's
# post-OFFER ARP probe, which waits out two 500ms coarse-timer ticks per try
# before accepting an address the router already reserved for us. Turning it off
# is the standard trade on a single-DHCP-server home/office LAN. This is a
# Kconfig choice, so the ARP option has to be displaced by picking another
# member -- setting LWIP_DHCP_DOES_ARP_CHECK=n on its own is silently ignored.
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
# Try the previously leased address first on reconnect, which skips the
# DISCOVER/OFFER round-trip when the lease is still ours.
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y

# Align image header with Tab5 hardware flash size.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8MiBplus-ota.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MEMTEST=
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_PLATFORM_TIME_ALT=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=50768

# ESP32-P4 has no ULP coprocessor.
CONFIG_SOC_ULP_SUPPORTED=n
CONFIG_ULP_COPROC_ENABLED=n
CONFIG_ULP_COPROC_TYPE_FSM=n

# Built-in camera (camera_tab5.c). The Tab5's SC2356 answers to the SC202CS
# driver: MIPI-CSI, RAW8 1280x720 at 30 fps, which the ISP turns into RGB565.
# The BSP pulls esp_video in but leaves every sensor off, so nothing was
# detected until this. The ISP pipeline controller is the task that runs auto
# exposure and white balance against the ISP statistics; without it the frames
# come out dark and green. Tab5 has no parallel (DVP) camera connector.
CONFIG_CAMERA_SC202CS=y
CONFIG_CAMERA_SC202CS_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC202CS_MIPI_RAW8_1280X720_30FPS=y
CONFIG_CAMERA_SC202CS_MIPI_DEFAULT_FMT_RAW8_1280X720_30FPS=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
# CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE is not set
# The SC202CS IPA configuration (sc202cs_default.json) runs ian, awb, agc,
# adn, acc and aen. Auto focus needs a lens motor the Tab5 does not have, and
# the AE target-level controller is not in that list either.
# CONFIG_ESP_IPA_AF_ALGORITHM is not set
# CONFIG_ESP_IPA_ATC_ALGORITHM is not set
# The hardware JPEG encoder (camera_capture()) hands a whole 1.8 MB RGB565 frame
# to esp_cache_msync() before the DMA reads it, and a cache-to-memory sync runs
# with interrupts off for the entire buffer. Chunking bounds that critical
# section to 128 KB on the P4. (It was tried first for the interrupt-watchdog
# panic in camera_capture() and did not cure it -- that turned out to be the
# camera interrupts living on the MicroPython core, see camera_tab5.c -- but a
# 1.8 MB stretch with interrupts off is still not something the audio task
# should have to live with.)
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS=y
# LVGL's example sources are compiled by default and never linked; skip them.
# CONFIG_LV_BUILD_EXAMPLES is not set

# Flash budget. Upstream MicroPython's ports/esp32/boards/sdkconfig.base sets
# these on every ESP32 board (Tulip CC inherits them; TAB5 does not, see the
# watchdog note above), and the camera stack is what finally pushed the app past
# its 0x3f0000 slot without them. The ROM already carries the nano printf
# (ESP_ROM_HAS_NEWLIB_NANO_FORMAT), so choosing it drops newlib's own vfprintf
# from flash; the Brainpool curves, Curve25519 and ALPN are TLS options nothing
# here negotiates.
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_MBEDTLS_SSL_ALPN=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=n

# Keep new I2C slave API enabled and silence legacy conflict checks.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
CONFIG_I2C_ENABLE_SLAVE_DRIVER_VERSION_2=y
